<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#F8F9FA">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Assign Leader"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#2D3436"
            android:layout_marginBottom="10dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Select Club"
            android:textStyle="bold"
            android:textColor="#2D3436" />

        <Spinner
            android:id="@+id/spinnerClubToAssign"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="6dp"
            android:background="#FFFFFF" />

        <EditText
            android:id="@+id/inputNewLeaderEmail"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_rounded_border"
            android:hint="New leader email"
            android:inputType="textEmailAddress"
            android:paddingHorizontal="12dp"
            android:textColor="#2D3436"
            android:textColorHint="#757575" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAssignLeader"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="14dp"
            android:text="Assign Leader"
            android:textAllCaps="false"
            android:backgroundTint="#00B894"
            android:textColor="#FFFFFF" />

        <TextView
            android:id="@+id/tvAssignLeaderStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text=""
            android:textSize="12sp"
            android:textColor="#636E72" />
    </LinearLayout>
</ScrollView>

