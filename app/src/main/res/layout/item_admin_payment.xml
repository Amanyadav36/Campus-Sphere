<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="10dp"
    app:cardElevation="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <TextView
            android:id="@+id/adminPaymentEvent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Event Title"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#2D3436" />

        <TextView
            android:id="@+id/adminPaymentUser"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="User Name"
            android:textSize="12sp"
            android:textColor="#636E72"
            android:layout_marginTop="4dp" />

        <TextView
            android:id="@+id/adminPaymentId"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Payment ID"
            android:textSize="12sp"
            android:textColor="#636E72"
            android:layout_marginTop="2dp" />

        <TextView
            android:id="@+id/adminPaymentStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Paid"
            android:textSize="12sp"
            android:textColor="#00B894"
            android:layout_marginTop="4dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp">

            <Button
                android:id="@+id/adminPaymentVerifyBtn"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:text="Verify"
                android:textColor="#FFFFFF"
                android:backgroundTint="#00B894" />

            <Button
                android:id="@+id/adminPaymentRejectBtn"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:text="Reject"
                android:textColor="#FFFFFF"
                android:backgroundTint="#D63031" />
        </LinearLayout>

    </LinearLayout>

</androidx.cardview.widget.CardView>
