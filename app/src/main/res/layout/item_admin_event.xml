<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="10dp"
    app:cardElevation="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <TextView
            android:id="@+id/adminEventTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Event Title"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#2D3436" />

        <TextView
            android:id="@+id/adminEventMeta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Date • Venue"
            android:textSize="12sp"
            android:textColor="#636E72"
            android:layout_marginTop="4dp" />

        <TextView
            android:id="@+id/adminEventPrice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="₹500"
            android:textSize="12sp"
            android:textColor="#636E72"
            android:layout_marginTop="2dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="10dp">

            <Button
                android:id="@+id/adminEventViewBtn"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:text="View"
                android:textColor="#FFFFFF"
                android:backgroundTint="#0984E3" />

            <Button
                android:id="@+id/adminEventFeatureBtn"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:text="Feature"
                android:textColor="#FFFFFF"
                android:backgroundTint="#00B894" />

            <Button
                android:id="@+id/adminEventDeleteBtn"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:text="Delete"
                android:textColor="#FFFFFF"
                android:backgroundTint="#D63031" />
        </LinearLayout>
    </LinearLayout>

</androidx.cardview.widget.CardView>
