<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/eventFormTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:text="Create New Event"
            android:textColor="#000000"
            android:textSize="24sp"
            android:textStyle="bold" />

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="200dp"
            app:cardBackgroundColor="#F1F2F6"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp">

            <ImageView
                android:id="@+id/eventPosterPreview"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="60dp"
                android:scaleType="centerCrop"
                android:src="@android:drawable/ic_menu_camera" />

            <Button
                android:id="@+id/uploadPosterBtn"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@android:color/transparent" />
        </androidx.cardview.widget.CardView>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:gravity="center"
            android:text="Tap above to upload poster"
            android:textColor="#000000"
            android:textSize="12sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Event Title"
            android:textColor="#000000"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/eventTitleInput"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_rounded_border"
            android:hint="e.g. Hackathon 2026"
            android:paddingHorizontal="12dp"
            android:textColor="#000000"
            android:textColorHint="#757575" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Category"
            android:textColor="#000000"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/eventCategoryInput"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_rounded_border"
            android:hint="e.g. Workshop"
            android:paddingHorizontal="12dp"
            android:textColor="#000000"
            android:textColorHint="#757575" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Date"
                    android:textColor="#000000"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/eventDateInput"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:background="@drawable/bg_rounded_border"
                    android:focusable="false"
                    android:hint="Select Date"
                    android:paddingHorizontal="12dp"
                    android:textColor="#000000"
                    android:textColorHint="#757575" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Time"
                    android:textColor="#000000"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/eventTimeInput"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:background="@drawable/bg_rounded_border"
                    android:focusable="false"
                    android:hint="Select Time"
                    android:paddingHorizontal="12dp"
                    android:textColor="#000000"
                    android:textColorHint="#757575" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Venue"
            android:textColor="#000000"
            android:textStyle="bold" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_rounded_border">

            <Spinner
                android:id="@+id/eventVenueSpinner"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:spinnerMode="dropdown" />
        </FrameLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Price"
            android:textColor="#000000"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/eventPriceInput"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_rounded_border"
            android:hint="e.g. 500 (or leave empty for Free)"
            android:inputType="number"
            android:paddingHorizontal="12dp"
            android:textColor="#000000"
            android:textColorHint="#757575" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Description"
            android:textColor="#000000"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/eventDescInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:background="@drawable/bg_rounded_border"
            android:gravity="top|start"
            android:hint="Describe your event..."
            android:inputType="textMultiLine|textCapSentences"
            android:maxHeight="300dp"
            android:minHeight="120dp"
            android:padding="12dp"
            android:scrollbars="vertical"
            android:textColor="#000000"
            android:textColorHint="#757575" />

        <Button
            android:id="@+id/generateCaptionBtn"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_gravity="end"
            android:layout_marginBottom="16dp"
            android:backgroundTint="#6C5CE7"
            android:text="✨ Generate with AI"
            android:textColor="#FFFFFF"
            android:textSize="12sp" />

        <CheckBox
            android:id="@+id/enableAttendanceCheck"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Enable Attendance System"
            android:textColor="#000000" />

        <Button
            android:id="@+id/publishEventBtn"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="40dp"
            android:backgroundTint="#0984E3"
            android:text="Publish Event"
            android:textStyle="bold" />

    </LinearLayout>
</ScrollView>
